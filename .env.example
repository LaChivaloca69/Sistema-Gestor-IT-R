# 1) Copia este archivo como ".env" en la misma carpeta que manage.py
#    (ejemplo: C:\GestorIT\.env).
# 2) Rellena los valores CAMBIAR-* antes de migrate / NSSM.
# 3) No subas .env a Git. El servicio lee este archivo al arrancar.

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=CAMBIAR-genera-una-con-el-comando-del-tutorial
DJANGO_ALLOWED_HOSTS=TIJITENG,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://TIJITENG:8000,http://127.0.0.1:8000

DB_NAME=GestorIT
DB_USER=gestor_app
DB_PASSWORD=CAMBIAR-contraseña-fuerte-postgres
DB_HOST=localhost
DB_PORT=5432
